# --- Required: a key for Jev -------------------------------------------------
# Jev makes the tool-selection call. The launchers (jev-codex, jev-claude, ...) ask for this on
# first run and save it to ~/.jev-gateway/.env, so you only need this file for a standalone server.
# Set ONE of the six. JEV_PROVIDER picks when several are set (default: the first one present).
TYPESAFE_API_KEY=
# OPENROUTER_API_KEY=
# AI_GATEWAY_API_KEY=
# OPENCODE_API_KEY=
# OPENJEV_KEY=placeholder   # OpenJev is local; any value works, the key is ignored
# JEV_PROVIDER=typesafe   # typesafe | openrouter | vercel | opencode | openjev | laya | jiwo

# --- Jiwo (local choice router; no key needed) ---------------------------------
# Install and run Jiwo separately; the gateway never downloads Python or checkpoints.
# Install from the pinned Jiwo commit outside this repository (see docs/jiwo-production.md).
# UV_TOOL_DIR=/opt/jev/jiwo/tools UV_TOOL_BIN_DIR=/opt/jev/jiwo/bin \
#   uv tool install --python 3.12 \
#   --from 'git+https://github.com/jiwidi/jiwo.git@e64d36227e02a36c0ea1bc3ec669003eb5a30c29' jiwo
# JIWO_CHECKPOINT=eljiwo/jiwo-0.8b JIWO_HOST=127.0.0.1 JIWO_PORT=8765 /opt/jev/jiwo/bin/jiwo serve
# JEV_PROVIDER=jiwo
# JEV_URL=http://127.0.0.1:8765/v1/systemone
# JEV_MODEL=jiwo-0.8b
# JEV_JIWO_MAX_STATE_CHARS=7000
# Jiwo handles the gateway's choice question; the gateway derives noul conservatively.
# Invalid, partial, unavailable or low-confidence responses fail open.

# --- Laya (local checkpoint; no key needed) ------------------------------------
# A local laya-serve answers instead of the remote Jev: offline, nothing leaves the machine.
# Run it separately (pip install "laya[serve]"; LAYA_HOST=127.0.0.1 laya-serve), then set:
# JEV_PROVIDER=laya
# LAYA_API_KEY=           # only when laya-serve itself requires a bearer key
# JEV_MODEL=              # english | multilingual (default) | typed-decisions
# JEV_LAYA_ROUTING_POLICY=legacy
# JEV_LAYA_SHADOW_POLICY=native  # optional background candidate; local Laya only
# JEV_LAYA_SHADOW_CONCURRENCY=1  # maximum simultaneous shadow calls, 1 to 4
# JEV_LAYA_EVALUATION_REPORT= # optional local evaluator JSON for dashboard metadata
# JEV_LAYA_MIN_CONFIDENCE=0.7
# JEV_LAYA_TIMEOUT_MS=8000
# These limits apply only to Laya; hosted providers use JEV_MAX_STATE_CHARS and JEV_MAX_MESSAGE_CHARS.
# JEV_LAYA_MAX_LEN=2048
# JEV_LAYA_MAX_STATE_CHARS=7000
# JEV_LAYA_MAX_MESSAGE_CHARS=1500

# --- Upstream LLM (any OpenAI-compatible API) -------------------------------
UPSTREAM_BASE_URL=https://api.openai.com/v1
# If set, replaces the client's Authorization header on upstream requests.
# If unset, the client's own Authorization header is forwarded as-is.
UPSTREAM_API_KEY=
# If set, clients must send "Authorization: Bearer <ROUTER_API_KEY>" (requires UPSTREAM_API_KEY).
ROUTER_API_KEY=
# Optional cheaper model used only to fill arguments once Jev has picked the tool.
ARGS_MODEL=

# --- Advisor -----------------------------------------------------------------
# The advisor launchers pin the main session model and enable advisor advice by default:
# jev-codex-advisor (GPT-6 Luna + a GPT advisor), jev-claude-advisor (Haiku + an advisor),
# and jev-agy-advisor (your selected Gemini model + Gemini 3.1 Pro by default). Claude's advisor
# defaults to claude-opus-5-5 but JEV_ADVISOR_MODEL can select any upstream-supported model.
# The plain launchers always disable it and keep the client's model default.
# The advisor can be switched at runtime with --advisor on|off.
JEV_ADVISOR=on
JEV_ADVISOR_MODEL=gpt-6-astra
# Setting this opts into sending bounded conversation text to a separate advisor provider.
# Requires an explicit base URL and model; supports OpenAI Chat Completions or Anthropic Messages.
# Remote URLs must use HTTPS; HTTP is allowed only for loopback. The advisor key is never reused upstream.
JEV_ADVISOR_PROVIDER=
JEV_ADVISOR_URL=
JEV_ADVISOR_API_KEY=
# Optional: low, medium or high. Set only when the selected model documents native effort support.
JEV_ADVISOR_EFFORT=
JEV_ADVISOR_TIMEOUT_MS=30000
JEV_ADVISOR_MAX_OUTPUT_TOKENS=700
JEV_ADVISOR_MAX_CALLS_PER_SESSION=6

# --- Routing ----------------------------------------------------------------
PORT=8787
# Interface to listen on. Keep loopback unless other machines must reach the gateway (then set ROUTER_API_KEY).
HOST=127.0.0.1
# Defaults to the provider's own Jev model (jev-latest, typesafe/jev-1.13, typesafe-ai/jev, jev-1.13-free).
# OpenCode defaults to free jev-1.13-free. To opt into paid jev-1.13, set JEV_MODEL=jev-1.13.
# If the free model is unavailable, the request goes to the LLM unchanged.
# JEV_MODEL=
JEV_TIMEOUT_MS=8000
# Request window sent to laya-serve; other providers ignore max_len.
JEV_LAYA_MAX_LEN=8192
# Below this confidence the request is forwarded untouched (the LLM decides).
JEV_MIN_CONFIDENCE=0.7
# Minimum certainty per closed-set argument before answering without the LLM.
JEV_ARG_MIN_CERTAINTY=0.8
# When Jev says "no tool needed": force_none (tool_choice=none) | passthrough
# Leave unset for provider defaults (Laya: passthrough; others: force_none).
# JEV_ON_NONE=force_none|passthrough
# Answer directly (no LLM call) when every argument is an enum/boolean.
JEV_DIRECT_CALLS=true
# off starts the gateway as a plain metering proxy (baseline for token comparisons).
# Can be flipped at runtime from the dashboard or with `jev-codex --routing on|off`.
JEV_ROUTING=on
# Hosted-provider state limit; Laya ignores this and uses JEV_LAYA_MAX_STATE_CHARS.
JEV_MAX_STATE_CHARS=60000
# Hosted-provider message limit; Laya ignores this and uses JEV_LAYA_MAX_MESSAGE_CHARS.
JEV_MAX_MESSAGE_CHARS=4000

# --- OpenCode launcher -------------------------------------------------------
# Set this to the existing OpenAI-compatible provider URL in OpenCode config.
# The launcher backs up opencode.json and repoints matching providers while its gateway is active.
JEV_OPENCODE_UPSTREAM_BASE_URL=https://api.openai.com/v1
# Optional per-client overrides belong in ~/.jev-gateway/.env.opencode and override this file.
# JEV_OPENCODE_UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1
# JEV_OPENCODE_CHECK=off skips OpenCode's startup config/bypass check.

# --- Headroom (Codex continuation outputs only) ----------------------------
# Both enabled modes send eligible tool output to Headroom; shadow only avoids changing upstream.
# Validated synthetic against the pinned v0.41.0 (see decision-record.md); stays off by default
# because the service returns the gateway's single JSON output unchanged (router:noop).
JEV_HEADROOM_MODE=off             # off | shadow | compress
# Explicit loopback endpoint; no default host or port. Must end in /v1/compress.
JEV_HEADROOM_URL=
JEV_HEADROOM_TIMEOUT_MS=500

# --- Debugging --------------------------------------------------------------
# Opt-in wire dumps: every routed request (decoded JSON body, credentials redacted), what the
# router changed, and the reply's usage / error body. Dumps contain the whole conversation.
JEV_DEBUG_DUMP_DIR=

# --- Dashboard (GET /dashboard) ---------------------------------------------
# Label for this router's traffic; the jev-codex / jev-claude launchers set it.
JEV_CLIENT=standalone
# JSON-lines file this server's stdout is appended to (e.g. `pnpm start >> router.log`): read once
# at startup so the dashboard's history survives restarts. The launchers set it.
JEV_LOG_FILE=

# Illustrative JSON profile only; fit thresholds on independent labeled data before use.
# JEV_LAYA_CALIBRATION={"version":1,"source":"calibration set","checkpoint":"english","policy":"native","buckets":{"3-5":{"threshold":0.9,"samples":30}}}
