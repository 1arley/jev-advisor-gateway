{
  "name": "jev-advisor-gateway",
  "version": "0.8.0",
  "description": "Local gateway that routes coding-agent tool decisions through Jev and can attach a read-only advisor (GPT or Claude).",
  "keywords": [
    "llm",
    "gateway",
    "proxy",
    "jev",
    "typesafe",
    "tool-calling",
    "codex",
    "claude-code",
    "opencode",
    "kilo",
    "gemini",
    "devin",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "author": "1arley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1arley/jev-advisor-gateway.git"
  },
  "homepage": "https://github.com/1arley/jev-advisor-gateway#readme",
  "bugs": {
    "url": "https://github.com/1arley/jev-advisor-gateway/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "jev-codex-advisor": "bin/jev-codex.mjs",
    "codex-jev-advisor": "bin/jev-codex.mjs",
    "jev-codex": "bin/jev-codex-basic.mjs",
    "jev-claude": "bin/jev-claude.mjs",
    "jev-claude-advisor": "bin/jev-claude-advisor.mjs",
    "jev-opencode": "bin/jev-opencode.mjs",
    "jev-gemini": "bin/jev-gemini.mjs",
    "jev-devin": "bin/jev-devin.mjs",
    "jev-kilo": "bin/jev-kilo.mjs"
  },
  "files": [
    "dist",
    "bin",
    "scripts/mock-jev.mjs",
    "scripts/laya-checkpoints.mjs",
    ".env.example",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/dashboard.html dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "codex": "node bin/jev-codex.mjs",
    "jev-codex-advisor": "node bin/jev-codex.mjs",
    "jev-codex": "node bin/jev-codex-basic.mjs",
    "claude": "node bin/jev-claude.mjs",
    "claude-advisor": "node bin/jev-claude-advisor.mjs",
    "opencode": "node bin/jev-opencode.mjs",
    "kilo": "node bin/jev-kilo.mjs",
    "gemini": "node bin/jev-gemini.mjs",
    "devin": "node bin/jev-devin.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.33.3"
}
